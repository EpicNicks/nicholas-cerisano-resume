Debug.Log("scene.lua: scene built (GPU smoke test: keys 1-" .. #Stations .. " visit the stations)")
-- Fly camera: "Camera Move" moves relative to where the camera faces, "Camera Rotate" turns and looks.
-- Port of test_project/src/CameraController.cpp.
-- "Station 1" ... "Station N" (keys 1-7 in scene.lua) jump to the smoke test's stations (SmokeStations.lua), looking
-- straight down -Z; it starts at station 1. "Demo Station 1" ... "Demo Station 4" (keys 8, 9, 0, Minus) jump to the demo
-- stations (DemoStations.lua) the same way.

local Stations = require("scripts.SmokeStations")
local DemoStations = require("scripts.DemoStations")

local CameraController = {}
CameraController.__index = CameraController

local SPEED = 10.0
local SENSITIVITY = 2.0
local MAX_PITCH = 89.0 * Math.DEG_TO_RAD

function CameraController:OnAttach()
    self.move = Vector2(0, 0)
    self.look = Vector2(0, 0)
    self.pitch = 0.0
    self.yaw = 0.0

    self:GoToStation(1)

    local controls = Input.LoadActionMap("Main Controls")
    if controls == nil then
        Debug.Warn("CameraController: 'Main Controls' action map not found")
        return
    end

    controls:Get("Camera Move"):Subscribe(function(action)
        self.move = action:GetVector2Value()
    end)
    controls:Get("Camera Rotate"):Subscribe(function(action)
        self.look = action:GetVector2Value()
    end)

    for index = 1, #(Stations or {}) do
        local station = controls:Get("Station " .. index)
        if station ~= nil then
            station:Subscribe(function(action)
                if action:GetPhase() == ActionPhase.Started then
                    self:GoToStation(index)
                end
            end)
        end
    end

    for index = 1, #(DemoStations or {}) do
        local station = controls:Get("Demo Station " .. index)
        if station ~= nil then
            station:Subscribe(function(action)
                if action:GetPhase() == ActionPhase.Started then
                    self:GoToStation(index, DemoStations)
                end
            end)
        end
    end
end

-- Puts the camera at station `index`'s viewpoint (of `list`, the smoke test's stations by default), looking down -Z.
-- Nothing without a camera or such a station.
function CameraController:GoToStation(index, list)
    local station = (list or Stations or {})[index]
    local camera = Camera.Main()
    if station == nil or camera == nil then
        return
    end
    self.pitch = 0.0
    self.yaw = 0.0
    camera:SetPosition(station.camera)
    camera:SetRotation(Quaternion.FromEulerAngles(self.pitch, self.yaw, 0.0))
end

function CameraController:OnUpdate()
    local camera = Camera.Main()
    if camera == nil then
        return
    end

    local dt = Time.deltaTime

    -- Movement
    local moveDir = Vector3(self.move.x, 0.0, -self.move.y)
    camera:SetPosition(camera:GetPosition() + camera:GetRotation() * (moveDir * (SPEED * dt)))

    -- Rotation
    if self.look.x ~= 0 or self.look.y ~= 0 then
        self.yaw = self.yaw - self.look.x * SENSITIVITY * dt
        self.pitch = math.max(-MAX_PITCH, math.min(MAX_PITCH, self.pitch + self.look.y * SENSITIVITY * dt))
    end

    camera:SetRotation(Quaternion.FromEulerAngles(self.pitch, self.yaw, 0.0))
end

return CameraController
-- The demo stations that follow the smoke test's seven (SmokeStations.lua): where the camera goes for each (keys 8, 9,
-- 0 and Minus, in CameraController.lua) and what the HUD says there (SmokeHud.lua). They are a separate list so the smoke
-- test keeps its seven stations ("Station 1/7") and its checklist (docs/testing.html). Every camera looks straight
-- down -Z, placed so the station sits in the top four fifths of the window, clear of the HUD.
-- require("scripts.DemoStations") returns the list; entry i is on the key named by its `key` field.

return {
    {
        name = "Particles",
        key = "Key8",
        camera = Vector3(120.0, 1.6, 16.0),
        look = "Three ParticleSystems: a blue water fountain, a sand burst that lands and lies on the ground, a grey "
            .. "smoke column that rises. Each sign says which backend it asked for and which is RUNNING (CPU, or PhysX "
            .. "GPU) and its live particle count. B: burst. P: play / stop. C: clear. K: backend Auto, CPU, PhysX. "
            .. "PhysX with no GPU particle backend runs on the CPU, and the sign says so.",
    },
    {
        name = "World canvas and colliders",
        key = "Key9",
        camera = Vector3(150.0, -1.0, 9.0),
        look = "A world-space panel with two buttons. Button A has a yellow trigger volume in front of it: it still "
            .. "clicks, because triggers never block a world canvas. Button B has a solid green block in front: "
            .. "clicking it hits the block, so its counter stays 0. Hover: darker. Hold: darker still.",
    },
    {
        name = "Text effect passes",
        key = "Key0",
        camera = Vector3(180.0, -0.6, 14.5),
        look = "TextRenderer:AddEffectPass on a grey board: an outline, a shadow and a glow, each one pass; then the "
            .. "same yellow and red passes twice. Before: added order puts red in front and hides the yellow. "
            .. "After: explicit orders bring the yellow back in front. Last: a pass at order -300 behind the "
            .. "settings shadow. The glow needs OpenGL.",
    },
    {
        name = "Soft bodies",
        key = "Minus",
        camera = Vector3(210.0, 1.6, 19.0),
        look = "SoftBody: cubes of 1e4, 1e5 and 1e6 Pa (soft squashes most), two spheres (damping 0.1, 3) and a "
            .. "robot body drop and wobble. Each sign says which backend it asked for and which is RUNNING (CPU or "
            .. "PhysX GPU). R: drop again. J: backend Auto, CPU, PhysX. V: push up. PhysX with no GPU soft-body "
            .. "backend runs on the CPU, and the sign says so.",
    },
}
-- The particle station's emitters (scene.lua builds them, ParticleStation.lua rebuilds them when the backend changes:
-- the backend is read when a system starts, so a new backend means a new system). Water, sand and smoke are tuned
-- with the ParticleSystem fields (rate, shape, speed, size, colour, gravity scale, drag, the ground plane) for the CPU
-- backend, and with pbdMaterial (Water, Sand, Smoke: the PBD preset the PhysX GPU backend uses; the CPU ignores it).

local Emitters = {}

Emitters.CENTER_X = 120.0
Emitters.GROUND_Y = -1.9
-- What K cycles through, as ParticleSystem:SetBackend names them
Emitters.BACKENDS = { "Auto", "CPU", "PhysX" }

Emitters.Specs = {
    {
        key = "Water",
        detail = "fountain, continuous",
        x = -5.5,
        y = Emitters.GROUND_Y + 0.05,
        continuous = true,
        burst = 120,
        configure = function(ps)
            ps:SetPbdMaterial("Water")
            ps:SetShape("Cone")
            ps:SetShapeRadius(0.15)
            ps:SetConeAngle(10.0)
            ps:SetSpeed(7.0, 9.0)
            ps:SetLifetime(1.8, 2.4)
            ps:SetSize(0.14, 0.1)
            ps:SetStartColor(Color.new(0.35, 0.6, 1.0, 0.9))
            ps:SetEndColor(Color.new(0.2, 0.4, 1.0, 0.2))
            ps:SetEmissionRate(150.0)
            ps:SetMaxParticles(2000)
            ps:SetGravityScale(1.0)
            ps:SetDrag(0.0)
            ps:SetGround(true, Emitters.GROUND_Y, 0.25)
        end,
    },
    {
        key = "Sand",
        detail = "burst, lands and lies",
        x = 0.0,
        y = 1.0,
        continuous = false,
        burst = 400,
        configure = function(ps)
            ps:SetPbdMaterial("Sand")
            ps:SetShape("Cone")
            ps:SetShapeRadius(0.3)
            ps:SetConeAngle(40.0)
            ps:SetSpeed(3.0, 6.0)
            ps:SetLifetime(7.0, 9.0)
            ps:SetSize(0.1, 0.1)
            ps:SetStartColor(Color.new(0.86, 0.7, 0.35, 1.0))
            ps:SetEndColor(Color.new(0.86, 0.7, 0.35, 1.0))
            ps:SetEmissionRate(0.0)
            ps:SetMaxParticles(1500)
            ps:SetGravityScale(1.0)
            ps:SetDrag(0.4)
            ps:SetGround(true, Emitters.GROUND_Y, 0.05)
        end,
    },
    {
        key = "Smoke",
        detail = "column, rises and fades",
        x = 5.5,
        y = Emitters.GROUND_Y + 0.05,
        continuous = true,
        burst = 40,
        configure = function(ps)
            ps:SetPbdMaterial("Smoke")
            ps:SetShape("Cone")
            ps:SetShapeRadius(0.3)
            ps:SetConeAngle(8.0)
            ps:SetSpeed(0.8, 1.4)
            ps:SetLifetime(3.5, 5.0)
            ps:SetSize(0.35, 1.3)
            ps:SetStartColor(Color.new(0.55, 0.55, 0.58, 0.55))
            ps:SetEndColor(Color.new(0.3, 0.3, 0.32, 0.0))
            ps:SetEmissionRate(30.0)
            ps:SetMaxParticles(600)
            ps:SetGravityScale(-0.12)
            ps:SetDrag(0.3)
            ps:SetGround(false, 0.0, 0.0)
        end,
    },
}

-- A new emitter object (in no scene yet: the caller adds it, which starts the system with `backend`) and its
-- ParticleSystem. `playing` false leaves a continuous emitter stopped, as after P.
function Emitters.Create(spec, backend, playing)
    local gameObject = GameObject.Create("Particles " .. spec.key)
    gameObject:CreatePositionable()
    gameObject:GetPositionable():SetPosition(Vector3(Emitters.CENTER_X + spec.x, spec.y, 0.0))
    local ps = gameObject:AddComponent("ParticleSystem")
    ps:SetBackend(backend)
    spec.configure(ps)
    ps:SetPlayOnAwake(spec.continuous and playing)
    -- Emitted when the system starts: the sand's only particles, and a first puff for the others
    ps:EmitBurst(spec.burst)
    return gameObject, ps
end

return Emitters
-- The particle station's behaviour (demo station 8): keys B (burst), P (play / stop), C (clear) and K (cycle the
-- requested backend Auto -> CPU -> PhysX) act only while the camera is at the station, and the signs above the emitters
-- show live which backend each ParticleSystem asked for, which is RUNNING and how many particles are alive.
-- Changing the backend replaces the emitters, since a system reads its backend when it starts.

local Emitters = require("scripts.ParticleEmitters")

local ParticleStation = {}
ParticleStation.__index = ParticleStation

local REFRESH_SECONDS = 0.2 -- the signs are rewritten five times a second, not every frame
local RANGE = 15.0          -- how far from the station's centre the camera still counts as being at it

-- Calls fn when the named action starts, if the map has it
local function OnStarted(controls, name, fn)
    local action = controls:Get(name)
    if action ~= nil then
        action:Subscribe(function(changed)
            if changed:GetPhase() == ActionPhase.Started then
                fn()
            end
        end)
    end
end

-- What the status sign says is running, from what was asked for and what the system reports
local function Running(asked, active)
    if active == nil then
        return "starting"
    elseif active == "PhysX" then
        return "PhysX GPU"
    elseif asked == "PhysX" then
        return "CPU (PhysX asked: fell back)"
    end
    return "CPU"
end

function ParticleStation:OnAttach()
    self.backendIndex = 1
    self.playing = true
    self.elapsed = REFRESH_SECONDS
    self.items = nil
    self.info = nil
    self.infoText = nil

    local controls = Input.LoadActionMap("Main Controls")
    if controls == nil then
        Debug.Warn("ParticleStation: 'Main Controls' action map not found")
        return
    end
    OnStarted(controls, "Particles Burst", function()
        self:ForEach(function(item) item.ps:EmitBurst(item.spec.burst) end)
    end)
    OnStarted(controls, "Particles Toggle", function() self:TogglePlaying() end)
    OnStarted(controls, "Particles Clear", function()
        self:ForEach(function(item) item.ps:Clear() end)
    end)
    OnStarted(controls, "Particles Backend", function() self:CycleBackend() end)
end

-- The emitters and signs scene.lua built, found once
function ParticleStation:Items()
    if self.items ~= nil then
        return self.items
    end
    local items = {}
    local scene = SceneManager.GetCurrentScene()
    if scene ~= nil then
        for _, spec in ipairs(Emitters.Specs) do
            local emitter = scene:FindGameObject("Particles " .. spec.key)
            local status = scene:FindGameObject("Particles Status " .. spec.key)
            if emitter ~= nil and status ~= nil then
                table.insert(items, {
                    spec = spec,
                    gameObject = emitter,
                    ps = emitter:GetComponent("ParticleSystem"),
                    status = status:GetComponent("TextRenderer"),
                    statusText = "",
                })
            end
        end
        local info = scene:FindGameObject("Particles Info")
        self.info = info and info:GetComponent("TextRenderer")
    end
    self.items = items
    return items
end

function ParticleStation:AtStation()
    local camera = Camera.Main()
    return camera ~= nil and math.abs(camera:GetPosition().x - Emitters.CENTER_X) < RANGE
end

function ParticleStation:Backend()
    return Emitters.BACKENDS[self.backendIndex]
end

-- Runs fn(item) for every emitter, when the camera is at the station
function ParticleStation:ForEach(fn)
    if not self:AtStation() then
        return
    end
    for _, item in ipairs(self:Items()) do
        fn(item)
    end
end

function ParticleStation:TogglePlaying()
    if not self:AtStation() then
        return
    end
    self.playing = not self.playing
    for _, item in ipairs(self:Items()) do
        if item.spec.continuous then
            if self.playing then
                item.ps:Play()
            else
                item.ps:Stop()
            end
        end
    end
end

-- Replaces every emitter with a new one asking for the next backend (the old ones go at the end of the frame)
function ParticleStation:CycleBackend()
    if not self:AtStation() then
        return
    end
    local scene = SceneManager.GetCurrentScene()
    if scene == nil then
        return
    end
    self.backendIndex = self.backendIndex % #Emitters.BACKENDS + 1
    for _, item in ipairs(self:Items()) do
        scene:DestroyGameObject(item.gameObject)
        item.gameObject, item.ps = Emitters.Create(item.spec, self:Backend(), self.playing)
        scene:AddRootGameObject(item.gameObject)
    end
    self.elapsed = REFRESH_SECONDS
end

function ParticleStation:OnUpdate()
    self.elapsed = self.elapsed + Time.deltaTime
    if self.elapsed < REFRESH_SECONDS then
        return
    end
    self.elapsed = 0.0

    local asked = self:Backend()
    local fellBack = false
    for _, item in ipairs(self:Items()) do
        local active = item.ps:GetActiveBackend()
        if asked == "PhysX" and active ~= nil and active ~= "PhysX" then
            fellBack = true
        end
        local text = string.format("asked: %s\nrunning: %s\nalive: %d", asked, Running(asked, active),
            item.ps:GetAliveCount())
        if text ~= item.statusText then
            item.statusText = text
            item.status:SetText(text)
        end
    end

    if self.info ~= nil then
        local text = string.format("Physics.IsGpuAvailable(): %s   backend asked: %s\n"
            .. "B burst   P play / stop   C clear   K backend: Auto, CPU, PhysX",
            tostring(Physics.IsGpuAvailable()), asked)
        if fellBack then
            text = text .. "\nPhysX asked but CPU is running: no GPU particle backend here (the log has one warning "
                .. "per emitter)."
        end
        if text ~= self.infoText then
            self.infoText = text
            self.info:SetText(text)
        end
    end
end

return ParticleStation
-- Quits when the "Quit" action starts. Port of test_project/src/StandardInputHandler.cpp.

local QuitHandler = {}
QuitHandler.__index = QuitHandler

function QuitHandler:OnAttach()
    local controls = Input.LoadActionMap("Main Controls")
    if controls == nil then
        Debug.Warn("QuitHandler: 'Main Controls' action map not found")
        return
    end

    controls:Get("Quit"):Subscribe(function(action)
        if action:GetPhase() == ActionPhase.Started then
            Application.Quit()
        end
    end)
end

return QuitHandler
-- The smoke test's heads-up display (on the "Smoke HUD" canvas, bottom-left): which station the camera is at and
-- what to look for there, also written to the log in case text doesn't draw. Keys 1-7 ("Station N") change station,
-- as in CameraController.lua, and show the screen-space UI panel only at the station that tests it; U ("Toggle UI
-- Panel") shows or hides the panel anyway, and H ("Toggle HUD") the HUD. Keys 8, 9, 0 and Minus ("Demo Station N") show
-- the demo stations (DemoStations.lua), headed "Demo N/4" so the smoke test stays "Station N/7".

local Stations = require("scripts.SmokeStations")
local DemoStations = require("scripts.DemoStations")

local SmokeHud = {}
SmokeHud.__index = SmokeHud

-- Calls fn when the named action starts, if the map has it
local function OnStarted(controls, name, fn)
    local action = controls:Get(name)
    if action ~= nil then
        action:Subscribe(function(changed)
            if changed:GetPhase() == ActionPhase.Started then
                fn()
            end
        end)
    end
end

function SmokeHud:OnAttach()
    self:ShowStation(1)

    local controls = Input.LoadActionMap("Main Controls")
    if controls == nil then
        Debug.Warn("SmokeHud: 'Main Controls' action map not found")
        return
    end

    for index = 1, #(Stations or {}) do
        OnStarted(controls, "Station " .. index, function() self:ShowStation(index) end)
    end
    for index = 1, #(DemoStations or {}) do
        OnStarted(controls, "Demo Station " .. index, function() self:ShowDemoStation(index) end)
    end
    OnStarted(controls, "Toggle UI Panel", function() self:TogglePanel() end)
    OnStarted(controls, "Toggle HUD", function() self:ToggleHud() end)
end

-- The UIText on the HUD's child called `name`, or nil
function SmokeHud:Text(name)
    local child = self.gameObject:FindChildRecursive(name)
    return child and child:GetComponent("UIText")
end

function SmokeHud:ShowStation(index)
    local station = Stations and Stations[index]
    if station == nil then
        return
    end
    local heading = string.format("Station %d/%d: %s", index, #Stations, station.name)
    local title = self:Text("HUD Title")
    if title ~= nil then
        title:SetText(heading)
    end
    local caption = self:Text("HUD Caption")
    if caption ~= nil then
        caption:SetText(station.look)
    end
    local panel = self:Panel()
    if panel ~= nil then
        panel:SetActive(station.uiPanel == true)
    end
    Debug.Log("GPU smoke test, " .. heading .. ". Look for: " .. station.look)
end

-- Like ShowStation, for the demo stations (which have no screen-space panel)
function SmokeHud:ShowDemoStation(index)
    local station = DemoStations and DemoStations[index]
    if station == nil then
        return
    end
    local heading = string.format("Demo %d/%d: %s", index, #DemoStations, station.name)
    local title = self:Text("HUD Title")
    if title ~= nil then
        title:SetText(heading)
    end
    local caption = self:Text("HUD Caption")
    if caption ~= nil then
        caption:SetText(station.look)
    end
    local panel = self:Panel()
    if panel ~= nil then
        panel:SetActive(false)
    end
    Debug.Log("GPU smoke test, " .. heading .. ". Look for: " .. station.look)
end

-- The screen-space UI station's canvas, or nil
function SmokeHud:Panel()
    local scene = SceneManager.GetCurrentScene()
    return scene and scene:FindGameObject("Smoke UI Panel")
end

function SmokeHud:TogglePanel()
    local panel = self:Panel()
    if panel ~= nil then
        panel:SetActive(not panel:IsActive())
    end
end

function SmokeHud:ToggleHud()
    local background = self.gameObject:FindChild("HUD Background")
    if background ~= nil then
        background:SetActive(not background:IsActive())
    end
end

return SmokeHud
-- The GPU smoke test's stations: where the camera goes for each (keys 1-7, in CameraController.lua) and what the HUD
-- says to look for there (SmokeHud.lua). Every camera looks straight down -Z. The cameras are placed so each station
-- sits in the top four fifths of a 16:9 (or 4:3) window, clear of the HUD in the bottom-left corner. The screen-space
-- UI panel, which covers the right of the window, is shown only at station 7 (or with U).
-- require("scripts.SmokeStations") returns the list; the station on key i is entry i.

return {
    {
        name = "Physics",
        camera = Vector3(-3.5, 0.0, 20.0),
        look = "The blue cube and the red sphere fall onto the grey floor and come to rest; the sphere rolls off "
            .. "the cube's edge. Nothing passes through the floor.",
    },
    {
        name = "World text",
        camera = Vector3(-30.8, -0.6, 12.0),
        look = "TextRenderer through the SDF text shader: white text at 1.0, 0.5 and 0.25 units per em, all crisp "
            .. "with smooth edges, no boxes or stray marks around the glyphs; the blue paragraph wraps onto "
            .. "several centred lines.",
    },
    {
        name = "Text effects",
        camera = Vector3(-60.6, -0.6, 13.5),
        look = "On the grey board: a red outline, a hard black drop shadow, a cyan glow, blurred edges and all of "
            .. "them combined, each as its caption says. No rectangles around glyphs. Glow and softness need "
            .. "OpenGL; the software renderer draws them hard-edged.",
    },
    {
        name = "World canvas",
        camera = Vector3(30.0, -1.0, 9.0),
        look = "A see-through blue panel in the world with a title, the arrow icon and an orange button. Hover "
            .. "the button: darker; hold the left button: darker still; release over it: World clicks +1. The red "
            .. "cube behind shows dimly through the panel; the green cube in front hides its lower-left corner.",
    },
    {
        name = "Materials",
        camera = Vector3(59.4, -0.5, 12.0),
        look = "Lit from the front upper left. Top: a spinning checker cube (red top-left on each face; faces "
            .. "toward you and the upper left bright, faces turned away to the right dim), a lit white sphere "
            .. "(bright upper left, darker lower right, a highlight) and a flat unlit white disc. Bottom: one "
            .. "striped texture opaque, blended and alpha-tested in front of a yellow bar.",
    },
    {
        name = "glTF model",
        camera = Vector3(89.75, -0.2, 9.0),
        look = "Two robots from smoke_robot.gltf, lit from the front upper left: a grey body with a bright face "
            .. "(cyan eyes above a red mouth, upright), orange arms (the right one tilted out), a teal pyramid head "
            .. "and an orange antenna. The right one spins as one piece: nothing comes apart.",
    },
    {
        name = "Screen UI",
        camera = Vector3(-3.5, 0.0, 20.0),
        uiPanel = true,
        look = "The panel on the right: the arrow icon upright, labels at left-top, centre and right-bottom of "
            .. "their boxes, the sentence wrapped inside its box. Click me: darker on hover, darker still pressed, "
            .. "Clicks +1 on release; Disable it greys it out. The world shows through the dark panel.",
    },
}
-- The soft-body station's bodies (scene.lua builds them, SoftBodyStation.lua rebuilds them when the backend changes:
-- a SoftBody reads its backend and resolution when it starts, so a new backend means a new body). Each is a
-- MeshRenderer plus a SoftBody on one object, with no Rigidbody. The CPU backend collides only with the plane
-- y = FLOOR_TOP (SetGround); the PhysX backend collides with the scene's colliders, so scene.lua gives the floor a
-- static BoxCollider at the same height.

local SoftBodies = {}

SoftBodies.CENTER_X = 210.0
SoftBodies.FLOOR_TOP = -1.9
-- What J cycles through, as SoftBody:SetBackend names them
SoftBodies.BACKENDS = { "Auto", "CPU", "PhysX" }

local ROBOT = "res://models/smoke_robot.gltf"
local TILT = Quaternion.FromEulerAngles(0.35, 0.0, 0.3) -- the cubes land on a corner, all the same way

-- Three cubes (soft, medium, stiff), two spheres (low and high damping) and the robot's body, side by side. A body
-- is dropped from `y` (its centre), `scale` times the mesh's size. stiffness is Young's modulus in pascals (rubber
-- is about 1e6), damping the velocity decay in 1/s; resolution is the voxels along the longest axis (the Lua API
-- has no tetrahedron count, so the signs show this).
SoftBodies.Specs = {
    {
        key = "Soft Cube", title = "Soft cube", mesh = "Cube", material = "res://materials/softbody_red.mat",
        x = -7.5, y = 3.2, scale = 1.6, tilt = TILT, stiffness = 1.0e4, damping = 0.1, resolution = 8,
    },
    {
        key = "Medium Cube", title = "Medium cube", mesh = "Cube", material = "res://materials/softbody_yellow.mat",
        x = -4.5, y = 3.2, scale = 1.6, tilt = TILT, stiffness = 1.0e5, damping = 0.1, resolution = 8,
    },
    {
        key = "Stiff Cube", title = "Stiff cube", mesh = "Cube", material = "res://materials/softbody_blue.mat",
        x = -1.5, y = 3.2, scale = 1.6, tilt = TILT, stiffness = 1.0e6, damping = 0.1, resolution = 8,
    },
    {
        key = "Low Damping", title = "Low damping", mesh = "Sphere", material = "res://materials/softbody_green.mat",
        x = 1.5, y = 3.2, scale = 1.6, stiffness = 3.0e4, damping = 0.1, resolution = 8,
    },
    {
        key = "High Damping", title = "High damping", mesh = "Sphere",
        material = "res://materials/softbody_cyan.mat",
        x = 4.5, y = 3.2, scale = 1.6, stiffness = 3.0e4, damping = 3.0, resolution = 8,
    },
    {
        -- The robot's body mesh and face material, on their own object (the robot's other nodes are not part of it)
        key = "Robot", title = "Robot body", mesh = ROBOT .. "#mesh/Body", material = ROBOT .. "#material/Face",
        x = 7.5, y = 3.2, scale = 1.0, stiffness = 5.0e4, damping = 0.3, resolution = 8,
    },
}

-- "1e+04" -> "1e4": a short stiffness for a sign
function SoftBodies.Short(number)
    return (string.format("%.0e", number):gsub("e%+?0*(%d)", "e%1"))
end

-- A new body object (in no scene yet: the caller adds it, which starts the body with `backend`) and its SoftBody
function SoftBodies.Create(spec, backend)
    local gameObject = GameObject.Create("Soft Body " .. spec.key)
    gameObject:CreatePositionable()
    local positionable = gameObject:GetPositionable()
    positionable:SetPosition(Vector3(SoftBodies.CENTER_X + spec.x, spec.y, 0.0))
    positionable:SetScale(Vector3(spec.scale, spec.scale, spec.scale))
    if spec.tilt ~= nil then
        positionable:SetRotation(spec.tilt)
    end
    local renderer = gameObject:AddComponent("MeshRenderer")
    renderer:SetMesh(spec.mesh)
    renderer:SetMaterial(1, spec.material)
    local body = gameObject:AddComponent("SoftBody")
    body:SetBackend(backend)
    body:SetResolution(spec.resolution)
    body:SetStiffness(spec.stiffness)
    body:SetDamping(spec.damping)
    body:SetGround(true, SoftBodies.FLOOR_TOP)
    return gameObject, body
end

return SoftBodies
-- The soft-body station's behaviour (demo station 11, key Minus): keys R (drop every body again), J (cycle the
-- requested backend Auto -> CPU -> PhysX) and V (push every body upwards) act only while the camera is at the station,
-- and the signs under the bodies' titles show live which backend each SoftBody asked for and which is RUNNING.
-- Changing the backend replaces the bodies, since a SoftBody reads its backend only when it starts.

local Bodies = require("scripts.SoftBodies")

local SoftBodyStation = {}
SoftBodyStation.__index = SoftBodyStation

local REFRESH_SECONDS = 0.2 -- the signs are rewritten five times a second, not every frame
local RANGE = 15.0          -- how far from the station's centre the camera still counts as being at it
local START_SECONDS = 1.0   -- a body with no backend yet is "starting" for this long, then "inert"
local PUSH = Vector3(0.0, 6.0, 0.0) -- what V adds to every body's velocity, in world units per second

-- Calls fn when the named action starts, if the map has it
local function OnStarted(controls, name, fn)
    local action = controls:Get(name)
    if action ~= nil then
        action:Subscribe(function(changed)
            if changed:GetPhase() == ActionPhase.Started then
                fn()
            end
        end)
    end
end

-- What the status sign says is running, from what was asked for and what GetActiveBackendName reports ("" before
-- the body started, or when it is inert: no mesh, a Rigidbody, or a mesh it cannot tetrahedralise)
local function Running(asked, active, age)
    if active == "" then
        return age < START_SECONDS and "starting" or "inert"
    elseif active == "PhysX" then
        return "PhysX GPU"
    elseif asked == "PhysX" then
        return "CPU (PhysX asked: fell back)"
    end
    return "CPU"
end

function SoftBodyStation:OnAttach()
    self.backendIndex = 1
    self.clock = 0.0
    self.elapsed = REFRESH_SECONDS
    self.items = nil
    self.info = nil
    self.infoText = nil

    local controls = Input.LoadActionMap("Main Controls")
    if controls == nil then
        Debug.Warn("SoftBodyStation: 'Main Controls' action map not found")
        return
    end
    OnStarted(controls, "Soft Bodies Reset", function()
        self:ForEach(function(item)
            item.body:Reset()
            item.created = self.clock
        end)
    end)
    OnStarted(controls, "Soft Bodies Backend", function() self:CycleBackend() end)
    OnStarted(controls, "Soft Bodies Push", function()
        self:ForEach(function(item) item.body:AddVelocity(PUSH) end)
    end)
end

-- The bodies and signs scene.lua built, found once
function SoftBodyStation:Items()
    if self.items ~= nil then
        return self.items
    end
    local items = {}
    local scene = SceneManager.GetCurrentScene()
    if scene ~= nil then
        for _, spec in ipairs(Bodies.Specs) do
            local object = scene:FindGameObject("Soft Body " .. spec.key)
            local status = scene:FindGameObject("Soft Body Status " .. spec.key)
            if object ~= nil and status ~= nil then
                table.insert(items, {
                    spec = spec,
                    gameObject = object,
                    body = object:GetComponent("SoftBody"),
                    status = status:GetComponent("TextRenderer"),
                    statusText = "",
                    created = 0.0,
                })
            end
        end
        local info = scene:FindGameObject("Soft Bodies Info")
        self.info = info and info:GetComponent("TextRenderer")
    end
    self.items = items
    return items
end

function SoftBodyStation:AtStation()
    local camera = Camera.Main()
    return camera ~= nil and math.abs(camera:GetPosition().x - Bodies.CENTER_X) < RANGE
end

function SoftBodyStation:Backend()
    return Bodies.BACKENDS[self.backendIndex]
end

-- Runs fn(item) for every body, when the camera is at the station
function SoftBodyStation:ForEach(fn)
    if not self:AtStation() then
        return
    end
    for _, item in ipairs(self:Items()) do
        fn(item)
    end
end

-- Replaces every body with a new one asking for the next backend (the old ones go at the end of the frame), each
-- back at its start pose above the floor
function SoftBodyStation:CycleBackend()
    if not self:AtStation() then
        return
    end
    local scene = SceneManager.GetCurrentScene()
    if scene == nil then
        return
    end
    self.backendIndex = self.backendIndex % #Bodies.BACKENDS + 1
    for _, item in ipairs(self:Items()) do
        scene:DestroyGameObject(item.gameObject)
        item.gameObject, item.body = Bodies.Create(item.spec, self:Backend())
        item.created = self.clock
        scene:AddRootGameObject(item.gameObject)
    end
    self.elapsed = REFRESH_SECONDS
end

function SoftBodyStation:OnUpdate()
    self.clock = self.clock + Time.deltaTime
    self.elapsed = self.elapsed + Time.deltaTime
    if self.elapsed < REFRESH_SECONDS then
        return
    end
    self.elapsed = 0.0

    local asked = self:Backend()
    local fellBack = false
    for _, item in ipairs(self:Items()) do
        local active = item.body:GetActiveBackendName()
        if asked == "PhysX" and active == "CPU" then
            fellBack = true
        end
        local text = string.format("asked: %s\nrunning: %s", asked, Running(asked, active, self.clock - item.created))
        if text ~= item.statusText then
            item.statusText = text
            item.status:SetText(text)
        end
    end

    if self.info ~= nil then
        local text = string.format("Physics.IsGpuAvailable(): %s   backend asked: %s\n"
            .. "R drop again   J backend: Auto, CPU, PhysX   V push up",
            tostring(Physics.IsGpuAvailable()), asked)
        if fellBack then
            text = text .. "\nPhysX asked but CPU is running: there is no PhysX GPU soft-body backend here (the log "
                .. "has one warning per body)."
        end
        if text ~= self.infoText then
            self.infoText = text
            self.info:SetText(text)
        end
    end
end

return SoftBodyStation
-- Turns its object about the world's Y axis, on top of the rotation it started with (the smoke test's textured cube
-- and robot).

local Spin = {}
Spin.__index = Spin

local RADIANS_PER_SECOND = 0.6

function Spin:OnAttach()
    self.angle = 0.0
    local positionable = self.gameObject:GetPositionable()
    self.startRotation = positionable and positionable:GetRotation() or Quaternion.FromEulerAngles(0.0, 0.0, 0.0)
end

function Spin:OnUpdate()
    local positionable = self.gameObject:GetPositionable()
    if positionable == nil then
        return
    end
    self.angle = self.angle + RADIANS_PER_SECOND * Time.deltaTime
    positionable:SetRotation(Quaternion.FromAxisAngle(Vector3.Up, self.angle) * self.startRotation)
end

return Spin
