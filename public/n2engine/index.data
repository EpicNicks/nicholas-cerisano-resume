local triggerDemoClicks = { A = 0, B = 0 }
do
    local cx, cy = 150.0, 0.3
    local canvas = UI.CreateCanvas("Trigger Demo Canvas", "WorldSpace") -- scale 0.01: 600 x 400 is 6 x 4 units
    canvas:GetComponent("Canvas"):SetSize(Vector2(600, 400))
